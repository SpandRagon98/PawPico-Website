{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spandragon98.github.io/PawPico-Website/store/specs/costume-manifest.schema.json",
  "title": "MewMuze Costume Manifest",
  "description": "Version 1 manifest for signed, declarative .mewcostume packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "creator",
    "description",
    "category",
    "supportedBodies",
    "minimumAppVersion",
    "maximumAppVersion",
    "thumbnail",
    "preview",
    "assets",
    "assetHashes",
    "packageSize",
    "licenseId",
    "signatureKeyId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "creator": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "supportedBodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["classic", "chonk", "fluffy", "siamese", "kitten"]
      }
    },
    "minimumAppVersion": { "$ref": "#/$defs/version" },
    "maximumAppVersion": {
      "oneOf": [
        { "$ref": "#/$defs/version" },
        { "type": "null" }
      ]
    },
    "thumbnail": { "$ref": "#/$defs/imagePath" },
    "preview": { "$ref": "#/$defs/imagePath" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "view", "layer"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^assets/(?!.*(?:^|/)\\.\\.?/)[a-zA-Z0-9._/-]+\\.(?:png|webp)$"
          },
          "view": { "enum": ["front", "side", "back", "all"] },
          "layer": { "const": "overlay" },
          "offsetX": { "type": "integer", "minimum": -512, "maximum": 512, "default": 0 },
          "offsetY": { "type": "integer", "minimum": -512, "maximum": 512, "default": 0 },
          "scale": { "type": "number", "minimum": 0.25, "maximum": 4, "default": 1 },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
        }
      }
    },
    "assetHashes": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 14,
      "propertyNames": { "$ref": "#/$defs/imagePath" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "packageSize": { "type": "integer", "minimum": 0, "maximum": 20971520 },
    "licenseId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "signatureKeyId": { "const": "store-key-2026-01" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "imagePath": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!/|\\\\|.*(?:^|/)\\.\\.?/|.*:)[a-zA-Z0-9._/-]+\\.(?:png|webp)$"
    }
  }
}
